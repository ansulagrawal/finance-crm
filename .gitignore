# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
coverage/
.nyc_output/
*.local

# ---------------------------------------------------------------------------
# Environment / secrets — NEVER commit real credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# Frontend build-time public config is safe to commit (baked into the bundle):
!.env.production

# Secret material of any kind
secret.*.json
secrets.*.json
SECRETS-README.md
/keys/
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
id_rsa*
docs/THIRD-PARTY-KEYS.md

# Database dumps (may contain real data)
*.sql.gz
*.dump
sql-dumps/

# ---------------------------------------------------------------------------
# Logs & runtime
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pids
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ---------------------------------------------------------------------------
# Caches / generated
# ---------------------------------------------------------------------------
.tanstack/
.turbo/
.cache/
.temp
.tmp
# Generated by @tanstack/router-plugin
**/src/routeTree.gen.ts

# ---------------------------------------------------------------------------
# Editors / OS / tooling
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-workspace

# AI agent local state
.claude/
.agents/
.husky/_/
