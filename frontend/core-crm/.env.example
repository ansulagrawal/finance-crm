# Dev-server proxy target. Only read by vite.config.ts (via loadEnv) to decide
# where /api/* is forwarded — it is never bundled into client code.
#
# Copy this file to .env.local and uncomment the box you want to work against.
# .env.local is gitignored; .env.example is not.

# Local backend (docker compose gateway) — the default when unset.
VITE_API_TARGET=http://localhost:8080

# Deployed dev box on EC2, via its Cloudflare-fronted domain. Cloudflare
# serves a publicly trusted certificate, so nothing here depends on the
# self-signed one still sitting on the origin.
# VITE_API_TARGET=https://api.financecrm.com

# Same box, bypassing Cloudflare by IP. Only reachable from an allow-listed
# source address, and it answers with the origin's self-signed certificate —
# vite.config.ts sets `secure: false` so the proxy accepts it.
# VITE_API_TARGET=https://203.0.113.10

# ---------------------------------------------------------------------------
# VITE_API_BASE_URL — absolute API origin, baked into the bundle at BUILD time.
#
# Leave it UNSET for local development: vite.config.ts proxies /api itself, so
# requests stay same-origin and no CORS is involved.
#
# A deployed build has no proxy. Cloudflare cannot rewrite /api/* to an
# external origin (see public/_redirects), so the built app must call the API
# by absolute URL. `.env.production` sets this, and `bun run build` picks it up
# automatically. Changing it requires a rebuild, not just a redeploy.
#
# The host it points at must share the CRM's registrable domain, or the
# SameSite=lax/strict auth cookies stop being sent and login silently fails.
# VITE_API_BASE_URL=https://api.financecrm.com
