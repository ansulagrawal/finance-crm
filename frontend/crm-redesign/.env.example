# Dev-server proxy target. Only read by vite.config.ts (via loadEnv) to decide
# where /api/* is forwarded — it is never bundled into client code.
#
# Copy this file to .env.local and uncomment the box you want to work against.
# .env.local is gitignored; .env.example is not.

# Local backend (docker compose gateway) — the default when unset.
VITE_API_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# VITE_API_BASE_URL — absolute API origin, baked into the bundle at BUILD time.
#
# Leave it UNSET for local development: vite.config.ts proxies /api itself, so
# requests stay same-origin and no CORS is involved.
#
# The host it points at must share the CRM's registrable domain, or the
# SameSite=lax/strict auth cookies stop being sent and login silently fails.
# VITE_API_BASE_URL=https://api.financecrm.com
