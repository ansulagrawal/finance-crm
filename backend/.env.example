DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=finance_crm_backend

# Generate with `openssl rand -hex 32`. @finance-crm/common's assertStrongSecrets()
# runs at every service's bootstrap and REFUSES TO START on a placeholder
# value or anything shorter than 32 characters — a guessable
# JWT_ACCESS_SECRET is total auth bypass (mint a token with roles ['SA'] for
# any user id), so a copied-verbatim example file must fail loudly at deploy
# time rather than boot quietly. NODE_ENV=development downgrades it to a
# warning, which is why the placeholder below is still usable locally.
JWT_ACCESS_SECRET=changeme
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=86400
BCRYPT_SALT_ROUNDS=10

# Rolling password-expiry window, ported from legacy's
# LoginController::dashboard() redirect. A user whose password is older than
# this (or who has never set one) is sent to forgot-password on sign-in.
PASSWORD_EXPIRY_DAYS=14

# Which way a repayment date moves when it lands on a Sunday or a company
# holiday: `previous` (default) or `next`. Client-confirmed business rule —
# see CamService.resolveWorkingRepaymentDate.
REPAYMENT_DATE_WORKING_DAY_DIRECTION=previous

# `development` downgrades assertStrongSecrets() from a hard boot failure to a
# warning, which is the only thing that makes the placeholder secrets above
# usable locally. NEVER set this to development in a deployed environment.
NODE_ENV=development

# Port each service listens on. Read directly from process.env (not
# ConfigService), so it must be a real environment variable, not an
# SSM/Secrets-Manager value. Defaults per service if unset: core-api 3000,
# integrations-api 3001, reporting-api 3002, automation-worker 3003.
PORT=

# Session cookies are `secure` unless this is explicitly "false" — that's the
# default because a deployment that simply forgets this variable must not end
# up shipping session cookies over cleartext http. Keep it false for local
# http development; delete it (or set true) everywhere else.
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the app (gateway/nginx = 1, an ALB in
# front of that = 2). Express's `trust proxy` uses it to pick the real client
# IP out of X-Forwarded-For — every audited IP (User.lastLoginIp,
# UserActivityLog, document-download and report-access logs) is the proxy's
# own address without it. A hop COUNT rather than `true` on purpose: `true`
# would let any client forge X-Forwarded-For and poison the audit trail.
TRUSTED_PROXY_HOPS=1

# Baseline per-IP request rate limit (@nestjs/throttler, registered globally
# in core-api and integrations-api). The credential endpoints (signin,
# forgot-password, verify-otp, reset, change-password) carry much tighter
# per-handler @Throttle budgets on top of this — see AuthController.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# Serves the Swagger UI + OpenAPI JSON. OFF by default: SwaggerModule mounts
# raw Express handlers the global JwtAuthGuard never sees, so enabling it in
# production publishes the complete route/parameter/DTO inventory to anyone
# who can reach the gateway.
SWAGGER_ENABLED=false

# Prints the password-reset OTP to the application log. LOCAL DEVELOPMENT
# ONLY — an OTP is the sole factor guarding a password reset, and logs reach
# far more people than a staff mailbox does. There is no delivery transport
# wired for this OTP yet, so with this off the reset flow issues an OTP that
# nobody receives; that gap predates this setting.
AUTH_OTP_DEBUG_LOG=false

# ============================================================================
# Config/secrets resolution chain (@finance-crm/common's awsSsmLoader/
# awsSecretsLoader), read by all 4 NestJS services in this precedence
# order. Each stage is OPTIONAL and independently skippable; a value found in
# an earlier stage always wins over the same key in a later stage:
#   1. AWS SSM Parameter Store   — only consulted if AWS_SSM_PARAMETER_PATH
#                                   (below) is set
#   2. AWS Secrets Manager       — only consulted if
#                                   AWS_SECRETS_MANAGER_SECRET_NAME (below)
#                                   is set
#   3. This .env file            — always read; every var in this file lives
#                                   here by default
# Nothing is read from the database. Cron schedules briefly were (via the
# crm_settings table); that was removed on 2026-08-07 by client instruction,
# so the CRON_* vars at the bottom of this file are the only override.
# ============================================================================

# --- Option: secrets stored in AWS Secrets Manager --------------------------
# One secret per environment. Its SecretString is a flat JSON object mapping
# env-var names straight to their real values, e.g.:
#   aws secretsmanager create-secret --name finance-crm/prod --secret-string \
#     '{"DB_PASSWORD":"...","JWT_ACCESS_SECRET":"...","INTERNAL_SERVICE_SECRET":"..."}'
# Set the SAME secret name in every service's env:
AWS_SECRETS_MANAGER_SECRET_NAME=

# --- Option: secrets stored in AWS SSM Parameter Store ----------------------
# One parameter per key, all under one path prefix — use type SecureString
# for anything sensitive (the loader always requests WithDecryption), e.g.:
#   aws ssm put-parameter --name /finance-crm/prod/DB_PASSWORD --value '...' --type SecureString
#   aws ssm put-parameter --name /finance-crm/prod/JWT_ACCESS_SECRET --value '...' --type SecureString
# Set the path prefix (trailing slash matters — it's stripped from each
# parameter's name to produce the key, e.g. /finance-crm/prod/DB_PASSWORD -> DB_PASSWORD):
AWS_SSM_PARAMETER_PATH=

# Both options read AWS credentials from the SDK's default provider chain
# (EC2 instance profile in production) — never put an AWS access key/secret
# anywhere in this file. See docs/DEPLOYMENT.md §6 for the exact IAM policy
# each service's role needs (secretsmanager:GetSecretValue /
# ssm:GetParametersByPath, scoped to this one secret/path — never "*").

# --- Full local dev: no AWS at all ------------------------------------------
# Leave AWS_SECRETS_MANAGER_SECRET_NAME and AWS_SSM_PARAMETER_PATH both blank
# (the default below) — every value in this file is then read directly from
# here, no AWS calls are ever made. Required just to BOOT each service
# (everything else in this file is a vendor credential only needed once you
# actually exercise that specific integration, and each adapter fails
# clearly at call time, not at boot, if left as "changeme"):
#   - all 4 services:               DB_HOST/PORT/USERNAME/PASSWORD/DATABASE
#                                    (defaults below assume a local MySQL on
#                                    the default port with a root user and no
#                                    password — override to match your setup)
#   - core-api/integrations-api/
#     reporting-api (NOT automation-worker, no public routes):
#                                    JWT_ACCESS_SECRET
#   - core-api/automation-worker
#     (NOT integrations-api/reporting-api):
#                                    INTERNAL_SERVICE_SECRET — required to
#                                    boot here because both call
#                                    integrations-api via IntegrationsApiClient.
#                                    integrations-api itself doesn't need it
#                                    to boot, but needs the SAME value set to
#                                    successfully verify those incoming calls
#                                    (otherwise they 401 — see JwtAuthGuard)

# File storage (@finance-crm/common's StorageModule) — local|s3, mirrors the legacy
# LMS_DOC_S3_FLAG toggle. Local-disk vars only matter when STORAGE_DRIVER=local;
# AWS vars only matter when STORAGE_DRIVER=s3 (credentials come from the AWS SDK's
# default provider chain, not from env vars read directly by this app).
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_LOCAL_PUBLIC_URL=http://localhost:3000/storage
AWS_S3_BUCKET=changeme
AWS_REGION=ap-south-1
AWS_S3_KEY_PREFIX=upload

# PDF generation (@finance-crm/common's PuppeteerPdfRenderer). Leave unset locally —
# Puppeteer manages its own cached Chromium. In Docker/production, set this
# to an OS-installed `chromium` binary path to avoid bundling a redundant
# Chromium download in the image.
PUPPETEER_EXECUTABLE_PATH=

# Account Aggregator (integrations-api) — RBI Account Aggregator
# consent-based bank-statement flow. Both the LEGACY (5-step Finvu-shaped)
# and NOVEL_PATTERN (CartBI single-request + webhook callback) flows are
# confirmed live in production and hit the SAME single vendor endpoint —
# legacy's `NP_URL`/`NP_TOKEN` env vars, renamed here for clarity. Not the
# same vendor/base URL as BANK_ANALYSIS_* below, even though both are
# CartBI ("Novel Pattern") — confirm before assuming they share a URL/token.
ACCOUNT_AGGREGATOR_NP_URL=changeme
ACCOUNT_AGGREGATOR_NP_TOKEN=changeme
LMS_URL=http://localhost:5173

# Razorpay (integrations-api) — Payment Links for loan-repayment collection.
# NEVER put real values here or in any committed file. The legacy app hardcodes
# a LIVE key/secret in old-php-files/components/includes/integration/integration_config.php —
# that credential should be rotated, not reused.
RAZORPAY_KEY_ID=changeme
RAZORPAY_KEY_SECRET=changeme
RAZORPAY_API_URL=https://api.razorpay.com/v1/payment_links/
RAZORPAY_CALLBACK_URL=https://changeme.example.com/pay-success
# Separate secret configured in the Razorpay dashboard for webhook HMAC verification
# (not the same as RAZORPAY_KEY_SECRET above) — legacy has no webhook/reconciliation
# at all, this closes that gap.
RAZORPAY_WEBHOOK_SECRET=changeme

# ICICI Bank EazyPay UPI QR/collect-pay API (integrations-api) — real vendor behind
# "UPI" collection, not a generic UPI gateway. Both the request and response/callback
# bodies are RSA-PKCS1 encrypted (request with ICICI's public key, response/callback
# readable only with our private key) — see UpiService/UpiCallbackController.
ICICI_UPI_MERCHANT_ID=changeme
ICICI_UPI_TERMINAL_ID=changeme
ICICI_UPI_API_KEY=changeme
ICICI_UPI_QR_API_URL=https://apibankingone.icici.bank.in/api/MerchantAPI/UPI/v0/QR3/changeme

# ---------------------------------------------------------------------------
# PEM key material is configured BY VALUE, not by file path.
#
# Deliberate: keys must never sit on an EC2/ECS filesystem. They live in AWS
# Secrets Manager (or here, locally) with every other secret, so there is
# nothing to mount, nothing baked into an image, nothing left on a terminated
# instance — and rotation is a secret update, not a deploy.
#
# A PEM is multi-line and .env is not, so `readPemFromConfig` (@finance-crm/common)
# accepts three equivalent forms and normalises all of them:
#   1. real newlines            — what a JSON secret naturally holds. Preferred.
#   2. literal \n sequences      — for a single-line .env entry, as below.
#   3. base64 of the whole PEM  — escape hatch if a pipeline mangles backslashes.
# It validates the result and names the offending variable, because OpenSSL's
# own error for a malformed key tells you nothing about which one it was.
#
# Flatten a PEM for form 2 with:
#   awk '{printf "%s\\n", $0}' keys/icici_upi_private.pem
# ---------------------------------------------------------------------------
# ICICI's public key (encrypts our request) and ours (decrypts their
# response/callback).
ICICI_UPI_PUBLIC_KEY=changeme
ICICI_UPI_PRIVATE_KEY=changeme

# ICICI API Banking — loan DISBURSAL (integrations-api's icici-disbursement
# module). THIS MOVES REAL MONEY: composite-payment sends an IMPS transfer to
# the customer's bank account. Treat every value here as production-critical.
#
# Key material is configured by VALUE (see the PEM note above), not by path —
# the legacy repo committed its ICICI production private key to disk, which is
# exactly the failure mode this avoids (docs/TODO.md; that key needs rotating).
#   - PUBLIC_CERT:  ICICI's certificate, used to RSA-encrypt the AES session
#                   key (legacy's prod_public_icici.txt)
#   - PRIVATE_KEY:  ours, used to decrypt their response (legacy's
#                   prod_private.key)
#
# Only IMPS is implemented — legacy never built a NEFT request payload, so a
# NEFT disbursal is rejected rather than guessed at.
#
# Unset values mean online disbursal fails at call time (the adapter throws on
# getOrThrow), which is the intended safe default: offline/manual disbursal
# keeps working and no half-configured transfer is ever attempted.
ICICI_DISBURSAL_PAYMENT_URL=https://apibankingone.icici.bank.in/api/v1/composite-payment
ICICI_DISBURSAL_STATUS_URL=https://apibankingone.icici.bank.in/api/v1/composite-status
ICICI_DISBURSAL_API_KEY=changeme
ICICI_DISBURSAL_PASSCODE=changeme
ICICI_DISBURSAL_BC_ID=changeme
# By value, same three accepted forms as ICICI_UPI_* above.
ICICI_DISBURSAL_PUBLIC_CERT=changeme
ICICI_DISBURSAL_PRIVATE_KEY=changeme
# Legacy used a 300s cURL timeout. Keep it generous: cutting a payment call
# short turns a probably-successful transfer into an unknown-outcome one, which
# then blocks all further attempts until someone reconciles with the bank.
ICICI_DISBURSAL_TIMEOUT_MS=300000

# ICICI eNACH mandate transaction scheduling (integrations-api). Legacy ships
# this hardcoded/stubbed (never calls the live endpoint) — this port makes
# the real call per the "real adapters, not mocks" rule, so these need real
# values to actually function.
ENACH_ICICI_MERCHANTID=changeme
ENACH_ICICI_SCHEDULING_URL=changeme

# Signzy (integrations-api) — the real vendor behind eKYC/Digilocker, eSign,
# bank account verification, face match, PAN/Aadhaar OCR + PAN fetch, UAN
# verification, domain/email verification, video KYC, and reverse geocode.
# NEVER put a real token here or in any committed file — the legacy app
# hardcodes multiple live Signzy tokens directly in PHP source
# (old-php-files/components/includes/integration/integration_config.php and
# payday_aadhaar_esign_api.php); those credentials should be rotated, not
# reused, since they've been sitting in plaintext in the legacy codebase.
SIGNZY_BASE_URL=https://api-preproduction.signzy.app/api/
SIGNZY_TOKEN=changeme

# Digitap (integrations-api) — live alternate provider to Signzy for PAN/
# Aadhaar OCR (OCR_PROVIDER=signzy default / digitap). NEVER put real
# values here — legacy hardcodes a live Digitap API token directly in
# old-php-files/components/includes/integration/integration_config.php.
OCR_PROVIDER=signzy
DIGITAP_API_TOKEN=changeme

# Email validation (integrations-api) — pluggable EMAIL_VALIDATOR token,
# SendGrid is the only implementation for now (real endpoint:
# POST https://api.sendgrid.com/v3/validations/email via the official
# @sendgrid/client SDK). Distinct from the existing Signzy-based
# domain-email-verification module. NEVER put a real value here.
SENDGRID_API_KEY=changeme

# RUNO (integrations-api) — call-center dialer, sanction-team call
# allocation only (`RUNO_CALL_CRM`/`CALL_ALLOCATION`). NEVER put a real
# value here — legacy hardcodes a live RUNO API key directly in
# old-php-files/components/includes/integration/integration_config.php.
RUNO_API_KEY=changeme

# Google Maps (integrations-api) — used only as a reverse-geocode fallback
# when Signzy fails. Legacy configured this integration (GOOGLE_MAPS/
# REVERSE_GEO_CODE) but never wired a caller to it; this is new resilience,
# not a ported legacy behavior.
GOOGLE_MAPS_APIKEY=changeme
BRAND_NAME=Finance CRM

# Surepass (integrations-api) — the real, currently-live CRIF bureau report
# vendor (legacy's own Signzy CRIF passthrough is commented out of its live
# code path, not the vendor actually in use). Bearer-token auth. Only the
# first of CRIF's 3 legacy API steps is implemented — see docs/TODO.md.
SUREPASS_CRIF_URL=https://kyc-api.surepass.app/api/v1/credit-report-crif/fetch-report-pdf
SUREPASS_API_TOKEN=changeme

# CartBI ("Novel Pattern" internally, integrations-api) — bank-statement
# fraud-score/average-balance analysis. Legacy has a live plaintext token
# hardcoded in integration_config.php (see docs/TODO.md's credential-rotation
# note) — do not copy that value here, get a freshly rotated one.
BANK_ANALYSIS_UPLOAD_URL=https://cartbi.com/api/upload
BANK_ANALYSIS_DOWNLOAD_URL=https://cartbi.com/api/downloadFile
BANK_ANALYSIS_API_TOKEN=changeme

# Vapio SMS (integrations-api) — the only SMS gateway implemented, and the
# real currently-active one. NEVER put real values here: the legacy app
# hardcodes a live Vapio username/API key/PE_ID directly in
# old-php-files/components/includes/integration/payday_sms_sent_api.php, and
# that credential should be rotated, not reused. (Legacy also carried
# credentials for several SMS/WhatsApp vendors this backend deliberately does
# not implement — those are listed in docs/EXCLUDED.md, and every one of them
# is a live secret sitting in the legacy repo that should be revoked.)
VAPIO_SMS_API_URL=https://vapio.in/api.php?
VAPIO_USERNAME=changeme
VAPIO_API_KEY=changeme
VAPIO_SENDER_ID=changeme
VAPIO_PE_ID=changeme

# Email (integrations-api) — EMAIL_PROVIDER picks the send mechanism:
# "smtp" (default, zero-config-safe), "zeptomail" (legacy's actual live
# production sender — common_send_email()'s $active_id==1 branch), or "ses"
# (legacy's AWS SES config, present but never actually wired to a caller in
# legacy). NEVER put real values here — legacy hardcodes a live SMTP password,
# a live ZeptoMail token, and live AWS SES keys directly in
# old-php-files/components/includes/functions.inc.php and integration_config.php.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=changeme
SMTP_PASS=changeme
EMAIL_FROM=no-reply@financecrm.co.in
ZEPTOMAIL_URL=api.zeptomail.in/
ZEPTOMAIL_TOKEN=changeme
# AWS_REGION is NOT repeated here even though the SES sender also reads it —
# it is declared once, in the storage section above. A duplicate key in a .env
# file is silently last-one-wins, so two declarations that later drift apart
# would be a bug nobody could see.

# Externally reachable origin of this API, e.g. https://api.example.com. Used
# to build absolute URLs that leave the system — currently the logo in the
# password-reset email, which integrations-api serves itself at
# /api/v1/integrations/assets/. Distinct from INTEGRATIONS_API_URL below,
# which is the in-cluster address and unreachable from a mail client. Unset
# just falls back to a text wordmark instead of an image.
PUBLIC_API_URL=

# automation-worker — inter-service URL. Env-var-driven, never hardcoded:
# the same value here works as a docker-compose service name or an internal
# ALB DNS name/path in production with zero code changes.
INTEGRATIONS_API_URL=http://localhost:3001

# Shared secret for HMAC-authenticating service-to-service calls (core-api/
# automation-worker calling integrations-api's vendor endpoints over plain
# HTTP with no session cookie — @finance-crm/common's JwtAuthGuard verifies these via
# internal-service-auth.util.ts instead of the cookie-JWT path). Same value
# across core-api, automation-worker, and integrations-api — this is
# authenticating "is this a legit internal caller", not per-caller
# authorization, so one shared secret is enough (same pattern already used
# for JWT_ACCESS_SECRET across the 3 HTTP services). reporting-api never
# calls or is called internally, so it can leave this unset.
#
# Same assertStrongSecrets() rule as JWT_ACCESS_SECRET: core-api and
# integrations-api refuse to start on this placeholder outside development.
# Generate with `openssl rand -hex 32`. A guessable value here grants the
# SYSTEM identity on integrations-api, which the gateway proxies publicly.
INTERNAL_SERVICE_SECRET=changeme

# Shared secret authenticating the inbound vendor webhooks that carry no
# signature of their own: Signzy video-KYC and eSign completion callbacks,
# CartBI bank-analysis and account-aggregator callbacks. (Razorpay
# authenticates via x-razorpay-signature HMAC and ICICI UPI via RSA
# decryption of the body, so neither uses this.) Generate with
# `openssl rand -hex 32`, then configure the same value on each vendor's
# webhook so it comes back as the `x-callback-token` header — or, for vendor
# consoles that can't set custom headers, as a `?token=` query parameter.
#
# VendorCallbackTokenGuard FAILS CLOSED while this is unset: those four
# callbacks reject every request. That's deliberate — they decide whether a
# lead's KYC and loan-agreement signing count as completed, and a guard that
# waves requests through when its secret is missing is the exact bypass it
# exists to remove.
VENDOR_CALLBACK_TOKEN=

# Job runner (@finance-crm/common's JobRunnerModule) — leave unset to run cron jobs
# in-process (@nestjs/schedule, single instance only). Set to switch to
# Redis-backed BullMQ (retries, concurrency control, safe with multiple
# automation-worker replicas).
REDIS_URL=

# automation-worker email/SMS job recipients and branding, distinct from
# integrations-api's own vendor credentials above.
COMPANY_NAME=Acme Financial Services Pvt Ltd.
LEGAL_EMAIL=legal@financecrm.com
# Home state for the disbursal export's in-state/out-of-state split
# (reporting-api). Read via process.env, and the legacy state id is NOT stable
# across environments, so this is matched by name. Defaults to Rajasthan.
COMPANY_HOME_STATE_NAME=Rajasthan
# Internal ops recipient — legacy's CTO_EMAIL constant. Every
# outstanding-loan-digest-email "customer" notification goes here instead
# of the borrower (a real, intentional legacy override, not a porting bug
# — see that job's doc comment).
CTO_EMAIL=changeme
# IT-support address shown on the password-reset OTP email, so a recipient who
# did not request the reset knows where to report it. Legacy's TECH_EMAIL.
TECH_EMAIL=changeme

# Per-job cron overrides (@finance-crm/common's ConfigurableJobRunner) — every
# CRON_<NAME> below is set to that job's actual current default, so this
# section is a live mirror of automation-worker's real schedule, not just a
# list of names. To change a job's behavior in a given environment, edit its
# line directly:
#   - a real cron expression (e.g. "0 3 * * *") reschedules it
#   - "disabled" (case-insensitive) turns it off entirely
#   - deleting the line (or commenting it out) falls back to the same value
#     hardcoded in the service's source, i.e. no change from what's below

# Confirmed present in the real production crontab — enabled:
CRON_REPAYMENT_REMINDER_EMAIL_5_DAY=0 9 * * *
CRON_REPAYMENT_REMINDER_EMAIL_4_DAY=0 9 * * *
CRON_REPAYMENT_REMINDER_EMAIL_3_DAY=0 9 * * *
CRON_REPAYMENT_REMINDER_EMAIL_2_DAY=0 9 * * *
CRON_REPAYMENT_REMINDER_EMAIL_1_DAY=0 9 * * *
CRON_REPAYMENT_REMINDER_SMS_5_DAY=30 9 * * *
CRON_REPAYMENT_REMINDER_SMS_4_DAY=30 9 * * *
CRON_REPAYMENT_REMINDER_SMS_3_DAY=30 9 * * *
CRON_REPAYMENT_REMINDER_SMS_2_DAY=30 9 * * *
CRON_REPAYMENT_REMINDER_SMS_1_DAY=30 9 * * *
CRON_ALLOCATE_LEAD_HOLD_TO_SCREENER=0 2 * * *
CRON_ALLOCATE_APPLICATION_NEW_TO_CREDIT=*/30 * * * *
CRON_ALLOCATE_APPLICATION_HOLD_TO_CREDIT=0 2 * * *
CRON_ALLOCATE_PARTIAL_LEAD_NEW_TO_SCREENER=*/15 * * * *
CRON_ALLOCATE_PARTIAL_LEAD_REPEAT_TO_CREDIT=*/10 * * * *
CRON_LEGAL_NOTICE_EMAIL_60_90_DPD=45 9 * * *
# Nightly outstanding/DPD recompute (Task #135). Disabled by default pending a
# confirmed real crontab schedule — see that task's note.
CRON_LOAN_OUTSTANDING_RECOMPUTE=disabled
CRON_REPEAT_ONLINE_CUSTOMERS_ALLOCATION=*/2 * * * *

# Confirmed absent from the real production crontab — disabled by default:
CRON_SCREENER_LEAD_ALLOCATION_G50K=disabled
CRON_SCREENER_LEAD_ALLOCATION_B50K=disabled
CRON_REJECT_LEAD_SCREENER_TAT=disabled
CRON_REJECT_LEAD_NEW_BUCKET_TAT=disabled
CRON_REJECT_APPLICATION_CREDIT_TAT=disabled
CRON_COLLECTION_DEFAULTER_1_30_DPD=disabled
CRON_COLLECTION_DEFAULTER_31_60_DPD=disabled
CRON_COLLECTION_DEFAULTER_60_PLUS_DPD=disabled
CRON_APPLICATION_HOLD_REDISTRIBUTION_G50K=disabled
CRON_APPLICATION_HOLD_REDISTRIBUTION_B50K=disabled
CRON_LEAD_HOLD_REDISTRIBUTION=disabled
CRON_CREDIT_APPLICATION_ALLOCATION_G50K=disabled
CRON_CREDIT_APPLICATION_ALLOCATION_B50K=disabled
CRON_CREDIT_APPLICATION_ALLOCATION_REPEAT=disabled
CRON_CLOSED_LOAN_FEEDBACK_EMAIL=disabled
CRON_OUTSTANDING_LOAN_DIGEST_EMAIL=disabled
CRON_RELOAN_PITCH_EMAIL=disabled
CRON_NOT_CONTACTABLE_LEAD_EMAIL=disabled
CRON_NOT_CONTACTABLE_LEAD_SMS=disabled
CRON_POI_FATHER_NAME_SYNC=disabled
CRON_BIRTHDAY_EMAIL=disabled
